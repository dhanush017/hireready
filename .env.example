# =============================================================================
# Model provider selection
# =============================================================================
# Amazon Bedrock (Amazon Nova Lite) is the DEFAULT and is what the deployed
# Lambda uses. Leave MODEL_PROVIDER unset for Bedrock.
#
# Set MODEL_PROVIDER only for local development without Bedrock access:
#   MODEL_PROVIDER=groq     (uses the Groq variables below)
#   MODEL_PROVIDER=openai   (uses OPENAI_API_KEY)
# A GROQ_API_KEY / OPENAI_API_KEY on its own will NOT switch providers.
MODEL_PROVIDER=

# AWS Configuration (Bedrock default)
AWS_REGION=us-east-1

# Bedrock Model Configuration
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# =============================================================================
# Groq (local dev only — activated by MODEL_PROVIDER=groq)
# Never commit real values. Fill these in your local, gitignored .env file.
# =============================================================================
GROQ_API_KEY=
GROQ_MODEL_ID=
GROQ_MAX_TOKENS=

# Frontend (for local development)
VITE_API_URL=http://localhost:8000

# CORS (set to your Amplify URL in production)
CORS_ORIGIN=http://localhost:5173
